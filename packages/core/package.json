{
  "name": "@lumae/core",
  "version": "0.1.0",
  "description": "Lumae core: framework-free logic, palette engine and helpers shared by every Lumae adapter.",
  "author": "Indranil Bhattacharya",
  "keywords": ["lumae", "ui", "headless", "design-system", "accessibility", "oklch", "palette"],
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./palette": {
      "import": {
        "types": "./dist/palette.d.ts",
        "default": "./dist/palette.js"
      },
      "require": {
        "types": "./dist/palette.d.cts",
        "default": "./dist/palette.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "palette": [
        "./dist/palette.d.cts"
      ]
    }
  },
  "files": ["dist", "palette"],
  "scripts": {
    "build": "tsup && node ../../scripts/subpath-stubs.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
