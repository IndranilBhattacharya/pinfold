{
  "name": "@lumae/core",
  "version": "0.1.0",
  "description": "Lumae core: framework-free logic, palette engine and helpers shared by every Lumae adapter.",
  "author": "Indranil Bhattacharya",
  "keywords": ["lumae", "ui", "headless", "design-system", "accessibility", "oklch", "palette"],
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./palette": {
      "types": "./dist/palette.d.ts",
      "import": "./dist/palette.js",
      "require": "./dist/palette.cjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": { "palette": ["./dist/palette.d.ts"] }
  },
  "files": ["dist", "palette"],
  "scripts": {
    "build": "tsup && node ../../scripts/subpath-stubs.mjs"
  },
  "publishConfig": { "access": "public", "provenance": true }
}
