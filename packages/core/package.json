{
  "name": "@pinfold/core",
  "version": "0.20.0",
  "description": "Pinfold core: framework-free logic, palette engine and helpers shared by every Pinfold adapter.",
  "author": "Indranil Bhattacharya",
  "keywords": [
    "pinfold",
    "ui",
    "headless",
    "design-system",
    "accessibility",
    "oklch",
    "palette"
  ],
  "license": "MIT",
  "homepage": "https://pinfold.indranildev.in",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IndranilBhattacharya/pinfold.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/IndranilBhattacharya/pinfold/issues",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./palette": {
      "import": {
        "types": "./dist/palette.d.ts",
        "default": "./dist/palette.js"
      },
      "require": {
        "types": "./dist/palette.d.cts",
        "default": "./dist/palette.cjs"
      }
    },
    "./meta": {
      "import": {
        "types": "./dist/meta.d.ts",
        "default": "./dist/meta.js"
      },
      "require": {
        "types": "./dist/meta.d.cts",
        "default": "./dist/meta.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "palette": [
        "./dist/palette.d.cts"
      ],
      "meta": [
        "./dist/meta.d.cts"
      ]
    }
  },
  "files": [
    "dist",
    "palette",
    "meta"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/subpath-stubs.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
