{
  "$schema": "https://pinfold.indranildev.in/registry.schema.json",
  "version": 1,
  "core": {
    "packages": [
      "@pinfold/react",
      "@pinfold/css"
    ],
    "styles": "@pinfold/css/core.css"
  },
  "components": [
    {
      "name": "accordion",
      "import": "@pinfold/react/accordion",
      "styles": "@pinfold/css/accordion.css",
      "status": "stable",
      "description": "Collapsible disclosure rows. WAI-ARIA accordion pattern.",
      "variants": [
        "solid",
        "outline",
        "separated",
        "filled",
        "ghost"
      ],
      "hook": "useAccordion",
      "snippet": "<Accordion items={[{ title: 'Shipping', content: 'Ships in 2 days.' }]} />"
    },
    {
      "name": "button",
      "import": "@pinfold/react/button",
      "styles": "@pinfold/css/button.css",
      "status": "experimental",
      "description": "An action or a link that looks like one. Tones, loading, icons, focusable when disabled.",
      "variants": [
        "solid",
        "soft",
        "outline",
        "ghost",
        "link"
      ],
      "snippet": "<Button label=\"Save\" onClick={save} />",
      "hook": "useButton"
    },
    {
      "name": "spinner",
      "import": "@pinfold/react/spinner",
      "styles": "@pinfold/css/spinner.css",
      "status": "experimental",
      "description": "An indeterminate loading indicator with a live status label.",
      "variants": [],
      "snippet": "<Spinner label=\"Loading\" />",
      "hook": "useSpinner"
    },
    {
      "name": "separator",
      "import": "@pinfold/react/separator",
      "styles": "@pinfold/css/separator.css",
      "status": "experimental",
      "description": "A line between groups of content, with an optional label; solid, dashed or dotted.",
      "variants": [
        "solid",
        "dashed",
        "dotted"
      ],
      "hook": "useSeparator",
      "snippet": "<Separator label=\"or\" />"
    },
    {
      "name": "kbd",
      "import": "@pinfold/react/kbd",
      "styles": "@pinfold/css/kbd.css",
      "status": "experimental",
      "description": "A keyboard shortcut that adapts to the platform (⌘ on Apple, Ctrl elsewhere).",
      "variants": [
        "outline",
        "solid",
        "ghost"
      ],
      "hook": "useKbd",
      "snippet": "<Kbd keys={['mod', 'k']} />"
    },
    {
      "name": "skeleton",
      "import": "@pinfold/react/skeleton",
      "styles": "@pinfold/css/skeleton.css",
      "status": "experimental",
      "description": "A loading placeholder that swaps to the real content.",
      "variants": [
        "text",
        "rect",
        "circle"
      ],
      "hook": "useSkeleton",
      "snippet": "<Skeleton lines={3} />"
    }
  ],
  "planned": [
    "badge",
    "alert",
    "avatar",
    "card",
    "progress",
    "tooltip",
    "popover",
    "dialog",
    "menu",
    "toast",
    "field",
    "input",
    "checkbox",
    "radio-group",
    "switch",
    "toggle-group",
    "slider",
    "number-field",
    "input-otp",
    "tabs",
    "breadcrumb",
    "pagination",
    "stepper",
    "select",
    "combobox",
    "tag-group",
    "command",
    "table",
    "calendar",
    "date-picker"
  ]
}
