{
  "$schema": "https://pinfold.indranildev.in/registry.schema.json",
  "version": 1,
  "core": {
    "packages": [
      "@pinfold/react",
      "@pinfold/css"
    ],
    "styles": "@pinfold/css/core.css"
  },
  "components": [
    {
      "name": "accordion",
      "import": "@pinfold/react/accordion",
      "styles": "@pinfold/css/accordion.css",
      "status": "stable",
      "description": "Collapsible disclosure rows. WAI-ARIA accordion pattern.",
      "variants": [
        "solid",
        "outline",
        "separated",
        "filled",
        "ghost"
      ],
      "hook": "useAccordion",
      "snippet": "<Accordion items={[{ title: 'Shipping', content: 'Ships in 2 days.' }]} />"
    },
    {
      "name": "button",
      "import": "@pinfold/react/button",
      "styles": "@pinfold/css/button.css",
      "status": "experimental",
      "description": "An action or a link that looks like one. Tones, loading, icons, focusable when disabled.",
      "variants": [
        "solid",
        "soft",
        "outline",
        "ghost",
        "link"
      ],
      "snippet": "<Button label=\"Save\" onClick={save} />",
      "hook": "useButton"
    },
    {
      "name": "spinner",
      "import": "@pinfold/react/spinner",
      "styles": "@pinfold/css/spinner.css",
      "status": "experimental",
      "description": "An indeterminate loading indicator with a live status label.",
      "variants": [],
      "snippet": "<Spinner label=\"Loading\" />",
      "hook": "useSpinner"
    },
    {
      "name": "separator",
      "import": "@pinfold/react/separator",
      "styles": "@pinfold/css/separator.css",
      "status": "experimental",
      "description": "A line between groups of content, with an optional label; solid, dashed or dotted.",
      "variants": [
        "solid",
        "dashed",
        "dotted"
      ],
      "hook": "useSeparator",
      "snippet": "<Separator label=\"or\" />"
    },
    {
      "name": "kbd",
      "import": "@pinfold/react/kbd",
      "styles": "@pinfold/css/kbd.css",
      "status": "experimental",
      "description": "A keyboard shortcut that adapts to the platform (⌘ on Apple, Ctrl elsewhere).",
      "variants": [
        "outline",
        "solid",
        "ghost"
      ],
      "hook": "useKbd",
      "snippet": "<Kbd keys={['mod', 'k']} />"
    },
    {
      "name": "skeleton",
      "import": "@pinfold/react/skeleton",
      "styles": "@pinfold/css/skeleton.css",
      "status": "experimental",
      "description": "A loading placeholder that swaps to the real content.",
      "variants": [
        "text",
        "rect",
        "circle"
      ],
      "hook": "useSkeleton",
      "snippet": "<Skeleton lines={3} />"
    },
    {
      "name": "badge",
      "import": "@pinfold/react/badge",
      "styles": "@pinfold/css/badge.css",
      "status": "experimental",
      "description": "A status label, a count or a dot, in six tones.",
      "variants": [
        "solid",
        "soft",
        "outline"
      ],
      "hook": "useBadge",
      "snippet": "<Badge label=\"New\" />"
    },
    {
      "name": "alert",
      "import": "@pinfold/react/alert",
      "styles": "@pinfold/css/alert.css",
      "status": "experimental",
      "description": "A message box with a tone icon, title, description, actions and dismiss.",
      "variants": [
        "soft",
        "outline",
        "accent"
      ],
      "hook": "useAlert",
      "snippet": "<Alert title=\"Saved\" tone=\"success\" />"
    },
    {
      "name": "avatar",
      "import": "@pinfold/react/avatar",
      "styles": "@pinfold/css/avatar.css",
      "status": "experimental",
      "description": "A picture with initials as the fallback, a presence dot, or a stacked group.",
      "variants": [],
      "hook": "useAvatar",
      "snippet": "<Avatar name=\"Ada Lovelace\" />"
    },
    {
      "name": "card",
      "import": "@pinfold/react/card",
      "styles": "@pinfold/css/card.css",
      "status": "experimental",
      "description": "A surface with an image, a real heading, content and actions; optionally one link.",
      "variants": [
        "outline",
        "elevated",
        "filled",
        "ghost"
      ],
      "hook": "useCard",
      "snippet": "<Card title=\"Pro\" description=\"For teams\" />"
    },
    {
      "name": "progress",
      "import": "@pinfold/react/progress",
      "styles": "@pinfold/css/progress.css",
      "status": "experimental",
      "description": "A progress bar or ring, determinate or indeterminate, or a meter.",
      "variants": [],
      "hook": "useProgress",
      "snippet": "<Progress label=\"Uploading\" value={40} />"
    },
    {
      "name": "tooltip",
      "import": "@pinfold/react/tooltip",
      "styles": "@pinfold/css/tooltip.css",
      "status": "experimental",
      "description": "A hint on hover or keyboard focus.",
      "variants": [
        "inverse",
        "surface"
      ],
      "hook": "useTooltip",
      "snippet": "<Tooltip content=\"Copies the link\" trigger={{ label: \"Share\" }} />"
    },
    {
      "name": "popover",
      "import": "@pinfold/react/popover",
      "styles": "@pinfold/css/popover.css",
      "status": "experimental",
      "description": "A floating panel anchored to a trigger; a hover card with openOn: hover.",
      "variants": [],
      "hook": "usePopover",
      "snippet": "<Popover title=\"Share\" trigger={{ label: \"Share\" }} />"
    },
    {
      "name": "dialog",
      "import": "@pinfold/react/dialog",
      "styles": "@pinfold/css/dialog.css",
      "status": "experimental",
      "description": "A native modal dialog: centred, a sheet from any edge, or an alert dialog.",
      "variants": [],
      "hook": "useDialog",
      "snippet": "<Dialog title=\"Settings\" trigger={{ label: \"Open\" }} />"
    },
    {
      "name": "menu",
      "import": "@pinfold/react/menu",
      "styles": "@pinfold/css/menu.css",
      "status": "experimental",
      "description": "A dropdown or context menu from a list of rows, with keyboard support and typeahead.",
      "variants": [],
      "hook": "useMenu",
      "snippet": "<Menu trigger={{ label: \"Actions\" }} items={[{ label: \"Edit\" }]} />"
    },
    {
      "name": "toast",
      "import": "@pinfold/react/toast",
      "styles": "@pinfold/css/toast.css",
      "status": "experimental",
      "description": "Queued messages in a corner, paused while read and announced to screen readers.",
      "variants": [],
      "hook": "useToast",
      "snippet": "<Toast />"
    }
  ],
  "planned": [
    "field",
    "input",
    "checkbox",
    "radio-group",
    "switch",
    "toggle-group",
    "slider",
    "number-field",
    "input-otp",
    "tabs",
    "breadcrumb",
    "pagination",
    "stepper",
    "select",
    "combobox",
    "tag-group",
    "command",
    "table",
    "calendar",
    "date-picker"
  ]
}
