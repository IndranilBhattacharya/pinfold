{
  "name": "@lumae/__NAME__",
  "version": "0.1.0",
  "description": "Lumae __NAME__ — configuration-driven, WAI-ARIA compliant.",
  "keywords": ["react", "__NAME__", "aria", "headless", "lumae"],
  "license": "MIT",
  "sideEffects": ["*.css"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./lazy": {
      "types": "./dist/lazy.d.ts",
      "import": "./dist/lazy.js",
      "require": "./dist/lazy.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": { "@lumae/core": "0.1.0" },
  "peerDependencies": { "react": ">=16.8.0" },
  "publishConfig": { "access": "public" }
}
