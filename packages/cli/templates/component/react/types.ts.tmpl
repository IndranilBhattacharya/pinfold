import type * as React from 'react';
import type {
  LumaeDir,
  LumaeOrientation,
  LumaeRadius,
  LumaeSize,
  LumaeTone,
  Length,
  PropsBag,
} from '@lumae/core';
import type { LumaeComponent } from '../component';
import type { SlotOverrides, Slottable } from '../types';

/** Name every visual part. Consumers target these by name; do not rename later. */
export type __PASCAL__Slot = 'root' | 'item' | 'label';

export type __PASCAL__Variant = 'solid' | 'outline' | 'ghost';

/** Runtime state of one row. Passed to every function-valued config field. */
export interface __PASCAL__ItemState {
  id: string;
  index: number;
  selected: boolean;
  disabled: boolean;
  config: __PASCAL__ItemConfig;
}

/** Anything renderable: a node, or a function of the row's live state. */
export type __PASCAL__Node = Slottable<__PASCAL__ItemState>;

/** One row of data. This is the JSON a consumer — or a model — writes. */
export interface __PASCAL__ItemConfig {
  id?: string;
  label: __PASCAL__Node;
  disabled?: boolean;
  /** Per-row class and style overrides, same slot names as the root config. */
  classNames?: Partial<Record<__PASCAL__Slot, string>>;
  styles?: Partial<Record<__PASCAL__Slot, React.CSSProperties>>;
}

export interface __PASCAL__BehaviourConfig {
  items: __PASCAL__ItemConfig[];
  value?: string | null;
  defaultValue?: string | null;
  onValueChange?: (value: string | null) => void;
  orientation?: LumaeOrientation;
  dir?: LumaeDir;
  loop?: boolean;
  /** Id prefix — set it for deterministic SSR markup. */
  id?: string;
}

/** Numbers are px, strings pass through. Overrides the `size` preset per key. */
export interface __PASCAL__Dimensions {
  width?: Length;
  maxWidth?: Length;
  gap?: Length;
  paddingX?: Length;
  paddingY?: Length;
  fontSize?: Length;
  radius?: Length;
  borderWidth?: Length;
  duration?: Length;
}

export interface __PASCAL__AppearanceConfig {
  variant?: __PASCAL__Variant;
  size?: LumaeSize;
  tone?: LumaeTone;
  radius?: LumaeRadius;
  animate?: boolean;
  dimensions?: __PASCAL__Dimensions;
  /** Drop every Lumae class so you can style purely with Tailwind or your own CSS. */
  unstyled?: boolean;
  className?: string;
  style?: React.CSSProperties;
}

export interface __PASCAL__Config
  extends __PASCAL__BehaviourConfig,
    __PASCAL__AppearanceConfig,
    SlotOverrides<__PASCAL__Slot, __PASCAL__ItemState> {
  /** Replace an entire row. The last resort before dropping to prop getters. */
  renderItem?: (args: {
    state: __PASCAL__ItemState;
    props: PropsBag;
    children: React.ReactNode;
  }) => React.ReactNode;
}

/** Appearance after provider defaults are folded in. */
export interface Resolved__PASCAL__Appearance {
  variant: __PASCAL__Variant;
  size: LumaeSize;
  tone: LumaeTone;
  radius: LumaeRadius;
  animate: boolean;
  unstyled: boolean;
}

/** Props accepted by the component itself, merged onto the root element. */
export interface __PASCAL__RootProps {
  className?: string;
  style?: React.CSSProperties;
  children?: never;
  [key: `data-${string}`]: unknown;
}

/** Addressing a single row from a sub-component. */
export interface __PASCAL__PartProps {
  id?: string;
  index?: number;
  className?: string;
  style?: React.CSSProperties;
  children?: React.ReactNode;
}

export interface __PASCAL__State {
  items: __PASCAL__ItemState[];
  value: string | null;
  select: (id: string) => void;
  clear: () => void;
  focusItem: (index: number) => void;
  /** Equivalent to rendering the component, for callers who prefer a call. */
  render: (props?: __PASCAL__RootProps) => React.ReactElement;
  getRootProps: (props?: PropsBag) => PropsBag;
  getItemProps: (item: __PASCAL__ItemState, props?: PropsBag) => PropsBag;
}

/** Sub-components for hand-laid-out layouts the config cannot express. */
export interface __PASCAL__Parts {
  Item: (props: __PASCAL__PartProps) => React.ReactElement | null;
}

/**
 * What `use__PASCAL__()` returns: a component you render, that is also the
 * controller, that also carries its parts.
 */
export type __PASCAL__Api = LumaeComponent<
  __PASCAL__State & __PASCAL__Parts,
  __PASCAL__RootProps
>;
