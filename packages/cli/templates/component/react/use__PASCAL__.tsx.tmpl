import * as React from 'react';
import { ariaAttr, dataAttr, mergeProps, nextIndexFromKey, warnOnce, __DEV__ } from '@lumae/core';
import { useControllableState, useEvent, useId } from '../hooks';
import { useLumae } from '../provider';
import { useLumaeComponent, useStableParts } from '../component';
import { renderItem, renderRoot, type ViewContext } from './__PASCAL__View';
import type {
  Resolved__PASCAL__Appearance,
  __PASCAL__Api,
  __PASCAL__Config,
  __PASCAL__ItemState,
  __PASCAL__PartProps,
  __PASCAL__RootProps,
  __PASCAL__State,
} from './types';

/**
 * TODO: implement the matching WAI-ARIA Authoring Practices pattern.
 * https://www.w3.org/WAI/ARIA/apg/patterns/
 *
 * What ships here is the Lumae skeleton: controllable state, roving focus, prop
 * getters, dev diagnostics, and a hook that returns a component:
 *
 *   const Thing = use__PASCAL__({ items });
 *   return <Thing className="mt-4" />;
 *
 * Replace the roles and keyboard map with the ones your pattern requires, then
 * delete this comment.
 */
export function use__PASCAL__(config: __PASCAL__Config): __PASCAL__Api {
  const ctx = useLumae();
  const {
    items: itemConfigs,
    value: controlled,
    defaultValue = null,
    onValueChange,
    orientation = 'horizontal',
    dir = ctx.dir,
    loop = true,
    id: idProp,
  } = config;

  const appearance: Resolved__PASCAL__Appearance = {
    variant: config.variant ?? 'solid',
    size: config.size ?? ctx.size,
    tone: config.tone ?? ctx.tone,
    radius: config.radius ?? ctx.radius,
    animate: config.animate ?? !ctx.disableAnimation,
    unstyled: config.unstyled ?? false,
  };

  const baseId = useId(idProp);
  const refs = React.useRef<Array<HTMLElement | null>>([]);

  if (__DEV__) validate(config);

  const [value, setValue] = useControllableState<string | null>({
    value: controlled,
    defaultValue,
    onChange: onValueChange,
  });

  const items = React.useMemo<__PASCAL__ItemState[]>(
    () =>
      itemConfigs.map((item, index) => {
        const id = item.id ?? String(index);
        return { id, index, selected: value === id, disabled: !!item.disabled, config: item };
      }),
    [itemConfigs, value],
  );

  const select = useEvent((id: string) => {
    const item = items.find((i) => i.id === id);
    if (!item || item.disabled) return;
    setValue(id);
  });

  const focusItem = useEvent((index: number) => refs.current[index]?.focus());

  const onKeyDown = useEvent((event: React.KeyboardEvent, index: number) => {
    const next = nextIndexFromKey(event.key, index, items.length, { orientation, dir, loop });
    if (next === null) return;
    event.preventDefault();
    focusItem(next);
  });

  // Rendering reads through this ref so the returned component keeps a stable
  // identity while always seeing the current config and state.
  const viewRef = React.useRef<ViewContext>(null as unknown as ViewContext);

  const state: __PASCAL__State = {
    items,
    value,
    select,
    clear: useEvent(() => setValue(null)),
    focusItem,
    render: (props?: __PASCAL__RootProps) => renderRoot(viewRef.current, props),

    getRootProps: (props) =>
      mergeProps({ 'data-lumae': '__NAME__', 'data-orientation': orientation, dir }, props),

    getItemProps: (item, props) =>
      mergeProps(
        {
          type: 'button',
          id: `${baseId}-item-${item.id}`,
          'aria-disabled': ariaAttr(item.disabled),
          'data-state': item.selected ? 'selected' : 'idle',
          'data-disabled': dataAttr(item.disabled),
          'data-index': item.index,
          ref: (node: HTMLElement | null) => {
            refs.current[item.index] = node;
          },
          onClick: (event: React.MouseEvent) => {
            if (item.disabled) {
              event.preventDefault();
              return;
            }
            api.select(item.id);
          },
          onKeyDown: (event: React.KeyboardEvent) => onKeyDown(event, item.index),
        },
        props,
      ),
  };

  // Built once: a fresh identity each render would make React tear down and
  // rebuild the subtree on every parent update.
  const parts = useStableParts(() => {
    const pick = (props: __PASCAL__PartProps): __PASCAL__ItemState | undefined => {
      const rows = viewRef.current.api.items;
      return props.index != null
        ? rows[props.index]
        : props.id != null
          ? rows.find((row) => row.id === props.id)
          : rows[0];
    };

    return {
      Item: (props: __PASCAL__PartProps) => {
        const item = pick(props);
        return item
          ? renderItem(viewRef.current, item, { className: props.className, style: props.style })
          : null;
      },
    };
  });

  const api = useLumaeComponent<__PASCAL__State & typeof parts, __PASCAL__RootProps>(
    '__PASCAL__',
    { ...state, ...parts },
    (props) => renderRoot(viewRef.current, props),
  );

  viewRef.current = { api, config, a: appearance };

  return api;
}

/** Dev-only checks for mistakes that would otherwise show up as odd behaviour. */
function validate(config: __PASCAL__Config): void {
  const { items, value, onValueChange } = config;

  warnOnce(!Array.isArray(items), '__PASCAL__: `items` must be an array.');
  if (!Array.isArray(items)) return;

  const ids = items.map((item, i) => item.id ?? String(i));
  const duplicate = ids.find((id, i) => ids.indexOf(id) !== i);
  warnOnce(
    duplicate !== undefined,
    `__PASCAL__: duplicate item id ${JSON.stringify(duplicate)}. Ids must be unique.`,
  );

  warnOnce(
    value !== undefined && onValueChange === undefined,
    '__PASCAL__: `value` was passed without `onValueChange`, so it is frozen. ' +
      'Use `defaultValue` for uncontrolled behaviour.',
  );
}
