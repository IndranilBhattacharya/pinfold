import * as React from 'react';
import { describe, expect, it, vi } from 'vitest';
import { fireEvent, render, screen } from '@testing-library/react';
import { describePinfoldConformance } from '@pinfold/testing';
import { __PASCAL__ } from './__PASCAL__';
import { use__PASCAL__ } from './use__PASCAL__';

const items = [
  { id: 'a', label: 'First' },
  { id: 'b', label: 'Second' },
  { id: 'c', label: 'Third', disabled: true },
];

const buttons = () => screen.getAllByRole('button');

describe('__PASCAL__', () => {
  it('renders as a component returned from the hook', () => {
    function Demo() {
      const Thing = use__PASCAL__({ items, defaultValue: 'a' });
      return <Thing className="layout-class" />;
    }
    render(<Demo />);
    expect(buttons()[0]).toHaveAttribute('data-state', 'selected');
  });

  it('selects on click and reports the change', () => {
    const onValueChange = vi.fn();
    render(<__PASCAL__ items={items} onValueChange={onValueChange} />);

    fireEvent.click(buttons()[1]);
    expect(onValueChange).toHaveBeenLastCalledWith('b');
  });

  it('ignores disabled items but keeps them focusable', () => {
    render(<__PASCAL__ items={items} />);
    const third = buttons()[2];

    expect(third).toHaveAttribute('aria-disabled', 'true');
    expect(third).not.toHaveAttribute('disabled');
    fireEvent.click(third);
    expect(third).toHaveAttribute('data-state', 'idle');
  });

  it('moves focus with the arrow keys', () => {
    render(<__PASCAL__ items={items} />);
    const [first, second] = buttons();

    first.focus();
    fireEvent.keyDown(first, { key: 'ArrowRight' });
    expect(document.activeElement).toBe(second);

    fireEvent.keyDown(second, { key: 'Home' });
    expect(document.activeElement).toBe(first);
  });

  // TODO: add the keyboard map and roles your WAI-ARIA pattern requires.
});

describePinfoldConformance({
  name: '__NAME__',
  slots: ['root', 'item', 'label'],
  dimension: { key: 'paddingX', value: 24 },
  cssFile: 'packages/css/src/__NAME__.css',
  hook: { use: use__PASCAL__ as any, config: { items } },
  render: (config) => <__PASCAL__ items={items} defaultValue="a" {...config} />,
});
