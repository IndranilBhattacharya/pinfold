import * as React from 'react';
import { describe, expect, it } from 'vitest';
import { render } from '@testing-library/react';
import { renderToString } from 'react-dom/server';
import { describePinfoldConformance } from '@pinfold/testing';
import { __PASCAL__ } from './__PASCAL__';

describe('__PASCAL__', () => {
  it('renders its content', () => {
    const { container } = render(<__PASCAL__>Hello</__PASCAL__>);
    expect(container.textContent).toBe('Hello');
  });

  it('uses no hooks, so it renders in Server Components', () => {
    const element = (__PASCAL__ as unknown as { render: (p: object, r: null) => React.ReactElement }).render({ children: 'Hi' }, null);
    expect(renderToString(element)).toContain('Hi');
  });

  // TODO: the semantics and ARIA your pattern requires.
});

describePinfoldConformance({
  name: '__NAME__',
  kind: 'atom',
  slots: ['root', 'label'],
  dimension: { key: 'paddingX', value: 24 },
  cssFile: 'packages/css/src/__NAME__.css',
  render: (config) => <__PASCAL__ {...config}>Hello</__PASCAL__>,
});
