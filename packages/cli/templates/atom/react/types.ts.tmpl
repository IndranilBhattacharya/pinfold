import type * as React from 'react';
import type { Length, PinfoldSize, PinfoldTone } from '@pinfold/core';
import type { SlotOverrides } from '../types';

export type __PASCAL__Slot = 'root' | 'label';
export type __PASCAL__Variant = 'solid' | 'soft' | 'outline';

/** Passed to every slot `render` override. */
export interface __PASCAL__State {
  variant: __PASCAL__Variant;
}

export interface __PASCAL__Dimensions {
  paddingX?: Length;
  radius?: Length;
}

/** The own options. Every other attribute goes to the element. */
export interface __PASCAL__Options extends SlotOverrides<__PASCAL__Slot, __PASCAL__State> {
  children?: React.ReactNode;
  /** @default 'solid' */
  variant?: __PASCAL__Variant;
  /** Unset follows the nearest provider through CSS. */
  size?: PinfoldSize;
  /** Unset follows the nearest provider through CSS. */
  tone?: PinfoldTone;
  dimensions?: __PASCAL__Dimensions;
  /** @default false */
  unstyled?: boolean;
  className?: string;
}

export interface __PASCAL__Props extends __PASCAL__Options, Omit<React.HTMLAttributes<HTMLSpanElement>, keyof __PASCAL__Options> {}
