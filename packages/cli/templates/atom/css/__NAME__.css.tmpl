/* Pinfold — __NAME__. An atom: sizes come from the shared control tokens
   (--pinfold-control-*) and colour from the shared tone tokens (--pinfold-tone-*),
   so an unset size or tone follows the nearest provider through CSS alone.
   `dimensions` writes --pinfold-__NAME__-* and wins through the var() fallbacks.
   Tokens only: the conformance suite fails the build on a literal colour. */

@layer pinfold.components {
  .pinfold-__NAME__ {
    --pinfold-__CAMEL__-solid: var(--pinfold-tone-solid, var(--pinfold-color-accent));
    --pinfold-__CAMEL__-on: var(--pinfold-tone-on, var(--pinfold-color-accent-contrast));
    --pinfold-__CAMEL__-text: var(--pinfold-tone-text, var(--pinfold-color-accent));

    display: inline-flex;
    align-items: center;
    gap: var(--pinfold-control-gap);
    padding-inline: var(--pinfold-__NAME__-padding-x, var(--pinfold-control-pad-x));
    border-radius: var(--pinfold-__NAME__-radius, calc(var(--pinfold-control-radius-unit) * var(--pinfold-radius-scale, 1)));
    font-size: var(--pinfold-control-text);
    color: var(--pinfold-__CAMEL__-text);
  }

  .pinfold-__NAME__[data-variant='solid'] {
    background: var(--pinfold-__CAMEL__-solid);
    color: var(--pinfold-__CAMEL__-on);
  }
  .pinfold-__NAME__[data-variant='soft'] {
    background: color-mix(in oklch, var(--pinfold-__CAMEL__-solid) 12%, transparent);
  }
  .pinfold-__NAME__[data-variant='outline'] {
    border: var(--pinfold-border-width) solid color-mix(in oklch, var(--pinfold-__CAMEL__-text) 35%, var(--pinfold-color-border));
  }

  .pinfold-__NAME____label {
    min-inline-size: 0;
  }
}
