{
  "name": "@pinfold/react",
  "version": "0.1.0",
  "description": "Pinfold for React: hooks-first, config-driven, accessible components. One subpath per component.",
  "author": "Indranil Bhattacharya",
  "keywords": ["react", "ui", "components", "accordion", "hooks", "accessibility", "aria", "design-system", "pinfold"],
  "license": "MIT",
  "homepage": "https://pinfold.indranildev.in",
  "repository": { "type": "git", "url": "git+https://github.com/IndranilBhattacharya/pinfold.git", "directory": "packages/react" },
  "bugs": "https://github.com/IndranilBhattacharya/pinfold/issues",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./accordion": {
      "import": {
        "types": "./dist/accordion/index.d.ts",
        "default": "./dist/accordion/index.js"
      },
      "require": {
        "types": "./dist/accordion/index.d.cts",
        "default": "./dist/accordion/index.cjs"
      }
    },
    "./accordion/lazy": {
      "import": {
        "types": "./dist/accordion/lazy.d.ts",
        "default": "./dist/accordion/lazy.js"
      },
      "require": {
        "types": "./dist/accordion/lazy.d.cts",
        "default": "./dist/accordion/lazy.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "accordion": [
        "./dist/accordion/index.d.cts"
      ],
      "accordion/lazy": [
        "./dist/accordion/lazy.d.cts"
      ]
    }
  },
  "files": ["dist", "accordion"],
  "scripts": {
    "build": "tsup && node ../../scripts/subpath-stubs.mjs"
  },
  "dependencies": {
    "@pinfold/core": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
