{
  "name": "pinfold-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Pinfold: config-driven, hooks-first React UI library",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @pinfold/core -w @pinfold/css -w @pinfold/react",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty",
    "clean": "rimraf packages/*/dist",
    "size": "node scripts/size-check.mjs",
    "size:strict": "node scripts/size-check.mjs --strict",
    "verify": "npm run typecheck && npm test && npm run build && node scripts/check-dist.mjs && npm run size:strict && npm run types:check",
    "types:check": "attw --pack packages/core && attw --pack packages/react",
    "smoke": "node scripts/consumer-smoke.mjs",
    "fixtures": "node scripts/fixture-apps.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^8.0.10",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "^19.3.1",
    "rimraf": "^6.0.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Indranil Bhattacharya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IndranilBhattacharya/pinfold.git"
  },
  "license": "MIT"
}
