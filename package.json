{
  "name": "lumae-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Lumae: config-driven, hooks-first React UI library",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @lumae/core -w @lumae/css -w @lumae/react",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty",
    "clean": "rimraf packages/*/dist",
    "size": "node scripts/size-check.mjs",
    "size:strict": "node scripts/size-check.mjs --strict",
    "verify": "npm run typecheck && npm test && npm run build && npm run size:strict"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^22.10.1"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Indranil Bhattacharya",
  "license": "MIT"
}
