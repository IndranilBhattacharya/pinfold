{
  "name": "knotui-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Knot UI - configuration-driven React UI framework",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@knotui/core && npm run build --workspace=@knotui/accordion && npm run build --workspace=knotui",
    "dev": "npm run dev --workspace=@knotui/docs",
    "docs": "npm run dev --workspace=@knotui/docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty",
    "clean": "rimraf packages/*/dist apps/*/dist",
    "size": "node scripts/size-check.mjs",
    "size:strict": "node scripts/size-check.mjs --strict",
    "verify": "npm run typecheck && npm test && npm run build && npm run size:strict"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^22.10.1"
  },
  "engines": {
    "node": ">=18"
  }
}